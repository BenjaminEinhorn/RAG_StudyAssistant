# ============================================================
# MBAX 6418 Course Assistant — configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. All values below are DUMMY placeholders.
#
# Class services run on the class endpoint host (dobolyi.com),
# ports 9001 and above. Each service follows the OpenAI-compatible
# /v1 request format unless noted. Confirm exact ports/models with
# your team/professor before going live.
# ============================================================

# API key for the class OpenAI-compatible services (vision LLM, etc.)
COURSE_API_KEY=6418

# --- Answering / vision LLM -------------------------------------------------
COURSE_LLM_BASE_URL=http://dobolyi.com:9001/v1
COURSE_LLM_MODEL=deepseek-v4-flash-0731
COURSE_LLM_API_KEY=6418

# --- Text embeddings --------------------------------------------------------
COURSE_TEXT_EMBED_BASE_URL=http://dobolyi.com:9002/v1
COURSE_TEXT_EMBED_MODEL=text-embedding-3-small
COURSE_EMBED_DIM=1536

# --- Visual (image) embeddings ----------------------------------------------
COURSE_VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003/v1
COURSE_VISUAL_EMBED_MODEL=vision-embedding

# --- Multimodal / text reranker ---------------------------------------------
COURSE_RERANK_BASE_URL=http://dobolyi.com:9004/v1
COURSE_RERANK_MODEL=rerank-multilingual-v3

# --- Optional: local doc-parsing endpoint -----------------------------------
COURSE_PARSE_BASE_URL=http://dobolyi.com:9005/v1
COURSE_PARSE_MODEL=doc-parser

# --- App storage --------------------------------------------------------------
# Chunk size / overlap for text chunking (characters / overlap)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
# Where the app keeps its SQLite index metadata (not the embeddings DB)
DATA_DIR=./data
