# ============================================================
# MBAX 6418 Course Assistant — configuration
# Copy this file to `.env` and fill in the real key. NEVER commit `.env`.
#
# Endpoints, models and payload shapes below were verified against the live
# class services with `probe_endpoints.py` (vLLM 0.29.0). Re-run it if the
# professor changes anything.
# ============================================================

# Bearer key for every class service. Get it from the course materials.
COURSE_API_KEY=replace-with-class-api-key

# `local` = offline stubs (tests only; NOT semantic). `full` = live class services.
COURSE_BUILD_MODE=full

# --- Answering / vision LLM (reasoning model: thinking is disabled per request)
COURSE_LLM_BASE_URL=http://dobolyi.com:9001/v1
COURSE_LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# --- Text embeddings (Cohere-style POST /v2/embed with input_type query|document)
COURSE_TEXT_EMBED_BASE_URL=http://dobolyi.com:9002
COURSE_TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16
COURSE_EMBED_DIM=2048

# --- Visual embeddings (POST /v1/embeddings with chat-style `messages`;
#     embeds slide images AND text queries into the same 2048-d space)
COURSE_VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003/v1
COURSE_VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
COURSE_VISUAL_EMBED_DIM=2048

# --- Multimodal reranker (POST /rerank)
COURSE_RERANK_BASE_URL=http://dobolyi.com:9004
COURSE_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B

# --- Document OCR model (chat completions; not used by the default PyMuPDF parser)
COURSE_PARSE_BASE_URL=http://dobolyi.com:9005/v1
COURSE_PARSE_MODEL=dots.mocr

# --- Text chunking (characters / overlap)
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
